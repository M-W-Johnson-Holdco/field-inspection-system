{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "field-inspection-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-26",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"vars": {
		// OAuth clients of the TC and Peachtree portals; ID tokens issued to
		// these can be exchanged for an inspection session (public values).
		"PORTAL_GOOGLE_CLIENTS": "TC:129261519673-imu1prh6jq0p52j40mtr1rolhbp1ra8s.apps.googleusercontent.com,PT:372381771549-jhfnp02ogcu290utsm83vk5v8pi70dfk.apps.googleusercontent.com"
	},
	"rules": [
		{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }
	],
	"r2_buckets": [
		{
			"binding": "INSPECTIONS",
			"bucket_name": "field-inspections"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "PERMISSIONS",
			"id": "4d5de953acde4363b4b27bc84020afbb"
		}
	],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["MyDurableObject"] },
		{ "tag": "v2", "deleted_classes": ["MyDurableObject"] }
	]
}